<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>tech.kayys.erp</groupId>
    <artifactId>erp-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Kayys ERP Platform</name>
    <description>Modular ERP with DDD and Hexagonal Architecture</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Framework Versions -->
        <quarkus.version>3.6.0</quarkus.version>
        <archunit.version>1.1.0</archunit.version>
        <junit.version>5.10.0</junit.version>
        <assertj.version>3.24.2</assertj.version>
        <mockito.version>5.6.0</mockito.version>
        <testcontainers.version>1.19.3</testcontainers.version>
    </properties>

    <modules>
        <!-- Foundation -->
        <module>foundation/domain</module>
        <module>foundation/application</module>
        <module>foundation/reactive-mutiny</module>

        <!-- Architecture Tests -->
        <module>architecture/tests</module>

        <!-- Business Modules - Analytics -->
        <module>modules/analytics/domain</module>

        <!-- Business Modules - Asset -->
        <module>modules/asset/domain</module>

        <!-- Business Modules - Billing -->
        <module>modules/billing/domain</module>

        <!-- Business Modules - Catalog -->
        <module>modules/catalog/domain</module>
        <module>modules/catalog/application</module>
        <module>modules/catalog/infrastructure</module>
        <module>modules/catalog/interfaces</module>

        <!-- Business Modules - Communication -->
        <module>modules/communication/domain</module>

        <!-- Business Modules - Company -->
        <module>modules/company/domain</module>

        <!-- Business Modules - Compliance -->
        <module>modules/compliance/domain</module>

        <!-- Business Modules - CRM -->
        <module>modules/crm/domain</module>

        <!-- Business Modules - Document -->
        <module>modules/document/domain</module>

        <!-- Business Modules - Employee -->
        <module>modules/employee/domain</module>
        <module>modules/employee/application</module>

        <!-- Business Modules - Grocery POS -->
        <module>modules/grocery-pos/domain</module>
        <module>modules/grocery-pos/application</module>

        <!-- Business Modules - HRIS -->
        <module>modules/hris/domain</module>

        <!-- Business Modules - Integration -->
        <module>modules/integration/domain</module>

        <!-- Business Modules - Inventory -->
        <module>modules/inventory/domain</module>

        <!-- Business Modules - Kiosk -->
        <module>modules/kiosk/domain</module>
        <module>modules/kiosk/application</module>

        <!-- Business Modules - Omnichannel -->
        <module>modules/omnichannel/domain</module>

        <!-- Business Modules - Pricing -->
        <module>modules/pricing/domain</module>
        <module>modules/pricing/application</module>

        <!-- Business Modules - Project -->
        <module>modules/project/domain</module>

        <!-- Business Modules - Promotion -->
        <module>modules/promotion/domain</module>
        <module>modules/promotion/application</module>

        <!-- Business Modules - Purchasing -->
        <module>modules/purchasing/domain</module>
        <module>modules/purchasing/application</module>

        <!-- Business Modules - Risk -->
        <module>modules/risk/domain</module>

        <!-- Business Modules - Sales -->
        <module>modules/sales/domain</module>
        <module>modules/sales/application</module>

        <!-- Business Modules - Security -->
        <module>modules/security/domain</module>

        <!-- Business Modules - Stock Opname -->
        <module>modules/stockopname/domain</module>
        <module>modules/stockopname/application</module>

        <!-- Business Modules - Subscription -->
        <module>modules/subscription/domain</module>
        <module>modules/subscription/application</module>

        <!-- Business Modules - Tenant -->
        <module>modules/tenant/domain</module>

        <!-- Business Modules - Transaction -->
        <module>modules/transaction/domain</module>

        <!-- Business Modules - Warehouse -->
        <module>modules/warehouse/domain</module>

        <!-- Business Modules - Workflow -->
        <module>modules/workflow/domain</module>

        <!-- Business Modules - Workforce -->
        <module>modules/workforce/domain</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
