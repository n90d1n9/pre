    <artifactId>syirkah-configuration-modules</artifactId>
    <packaging>pom</packaging>

    <name>Syirkah Commerce - Configuration Aggregator</name>
    <description>
        Commerce Configuration Capability (product01.md Phase E):
        transient customer selections validated against product
        specifications, bridged to pricing. No persistence — selections
        live only for the duration of a transaction.
