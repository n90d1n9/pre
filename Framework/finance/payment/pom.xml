        <artifactId>syirkah-finance</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>finance-payment</artifactId>
    <packaging>pom</packaging>
    <name>Finance - Payment Engine</name>


    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>tech.kayys.syirkah</groupId>
                <artifactId>syirkah-payment-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.syirkah</groupId>
                <artifactId>syirkah-payment-method</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.syirkah</groupId>
                <artifactId>syirkah-payment-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.syirkah</groupId>
                <artifactId>syirkah-payment-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.syirkah</groupId>
                <artifactId>syirkah-payment-fnb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.syirkah</groupId>
                <artifactId>syirkah-payment-merchant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.syirkah</groupId>
                <artifactId>syirkah-payment-grpc</artifactId>
