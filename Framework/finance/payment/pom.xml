    <modules>
        <module>syirkah-payment-gateway</module>
        <module>syirkah-payment-method</module>
        <module>syirkah-payment-core</module>
        <module>syirkah-payment-merchant</module>
        <module>syirkah-payment-grpc</module>
        <module>syirkah-payment-rest</module>
        <module>processor</module>
        <!--
            PARKED (see Framework/README.md, "Parked legacy modules"):
            syirkah-payment-fnb and syirkah-payment-util still import
            jakarta.* plus tech.kayys.payment.model, tech.kayys.sy.tenant
            and tech.kayys.transaction.domain - APIs none of which exist
            in this workspace. They predate the reactor and were never
            built by it. Re-adding them is a migration task: declare the
            real Quarkus/Panache dependencies, map their code onto the
            current payment-core contracts, then list them here again.
        -->
    </modules>
